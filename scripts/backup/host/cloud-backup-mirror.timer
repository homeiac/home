# Daily SSK mirror. Host clock is UTC: 18:00 UTC = 10:00/11:00 Pacific, well after the 02:30 Pacific
# cloud-drive-pull CronJob. Persistent: a run missed while the host was off happens at next boot.
[Unit]
Description=Daily cloud backup mirror to SSK

[Timer]
OnCalendar=*-*-* 18:00:00 UTC
RandomizedDelaySec=10m
Persistent=true

[Install]
WantedBy=timers.target
