# Secondary copy of the cloud backup onto the SSK USB disk (scripts/backup/host/cloud-backup-mirror.sh)
# Installed by scripts/backup/cloud-backup-install-mirror.sh
[Unit]
Description=Cloud backup: mirror primary (ZFS snapshot) to SSK USB disk
After=zfs.target local-fs.target
Wants=zfs.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cloud-backup-mirror.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=12h
